{
  "id": "pointcloud-release-validation",
  "version": "1.0",
  "profile": "pointcloud-3d",
  "route": [
    "REQUIREMENT",
    "DESIGN",
    "IMPLEMENT",
    "REVIEW",
    "TEST",
    "KNOWLEDGE",
    "SUMMARY"
  ],
  "stages": [
    {
      "stage": "REQUIREMENT",
      "role": "Supervisor",
      "goal": "固定待发布代码、配置、模型、数据与验收协议。",
      "skills": [
        "vision-project-intake",
        "vision-dataset-audit"
      ],
      "engine": null
    },
    {
      "stage": "DESIGN",
      "role": "Executor",
      "goal": "设计回归、困难反例、协议、超时、回退与现场待验矩阵。",
      "skills": [
        "vision-model-selection",
        "vision-experiment-design"
      ],
      "engine": null
    },
    {
      "stage": "IMPLEMENT",
      "role": "Executor",
      "goal": "Experiment Engine 在隔离输出目录运行冻结候选，禁止修改被验证阈值。",
      "skills": [
        "vision-experiment-design",
        "vision-error-analysis"
      ],
      "engine": "experiment-engine"
    },
    {
      "stage": "REVIEW",
      "role": "Verifier",
      "goal": "检查实际 diff、原限值、默认关闭开关与版本追溯。",
      "skills": [
        "vision-evaluation"
      ],
      "engine": null
    },
    {
      "stage": "TEST",
      "role": "Verifier",
      "goal": "Evaluation Engine 对比同版本真值，检查误检漏检、几何误差、尾时延与失败率。",
      "skills": [
        "vision-evaluation",
        "vision-edge-deployment"
      ],
      "engine": "evaluation-engine"
    },
    {
      "stage": "KNOWLEDGE",
      "role": "Executor",
      "goal": "按需记录新边界和恢复方法。",
      "skills": [
        "vision-error-analysis"
      ],
      "engine": null
    },
    {
      "stage": "SUMMARY",
      "role": "Supervisor",
      "goal": "形成离线验收候选；现场资格与发布审批另行决定。",
      "skills": [
        "vision-evaluation"
      ],
      "engine": null
    }
  ],
  "checks": [
    "system-impact",
    "evidence-audit"
  ],
  "required_gate": "LoopForge REQUIREMENT user-confirmed",
  "outputs": [
    "experiment-record",
    "evaluation-report",
    "workflow-summary"
  ]
}
